		{
			"content": "<script lang=\"ts\" module>\n\texport type ToolStatus = \"running\" | \"done\" | \"error\";\n</script>\n\n<script lang=\"ts\">\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport * as Collapsible from \"$UI$/collapsible/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { Component, Snippet } from \"svelte\";\n\timport ToolChip from \"./tool-chip.svelte\";\n\timport ToolCallSection from \"./tool-call-section.svelte\";\n\n\t// What an agent did on the way to its answer, as a card: the chip is the header, and the input and output open\n\t// below it. Pass `children` to render the result yourself (a table or a card instead of JSON), `actions` for\n\t// extra controls such as Retry. Ported from the Another UI (React) Tool Call.\n\tlet {\n\t\tname,\n\t\tstatus = \"done\",\n\t\ticon,\n\t\tduration,\n\t\tinput,\n\t\toutput,\n\t\terror,\n\t\tchildren,\n\t\tactions,\n\t\topen = $bindable(false),\n\t\tclass: className,\n\t}: {\n\t\tname: string;\n\t\tstatus?: ToolStatus;\n\t\ticon?: Component<{ class?: string }>;\n\t\tduration?: number;\n\t\tinput?: unknown;\n\t\toutput?: unknown;\n\t\t/** An error message shown in place of the output. */\n\t\terror?: string;\n\t\tchildren?: Snippet;\n\t\tactions?: Snippet;\n\t\topen?: boolean;\n\t\tclass?: string;\n\t} = $props();\n\n\tconst hasBody = $derived(\n\t\tinput !== undefined || output !== undefined || !!error || !!children || !!actions\n\t);\n</script>\n\n<Collapsible.Root\n\tbind:open\n\tdata-slot=\"tool-call\"\n\tdata-status={status}\n\tclass={cn(\n\t\t\"group/tool w-full min-w-0 overflow-hidden rounded-lg border bg-card text-card-foreground data-[status=error]:border-destructive/30\",\n\t\tclassName\n\t)}\n>\n\t<Collapsible.Trigger\n\t\tdisabled={!hasBody}\n\t\tclass=\"flex w-full min-w-0 cursor-pointer items-center gap-1.5 px-3 py-2 text-left text-xs font-medium outline-none hover:bg-muted/50 focus-visible:ring-3 focus-visible:ring-ring/50 disabled:cursor-default disabled:hover:bg-transparent\"\n\t>\n\t\t<ToolChip {name} {status} {icon} {duration} class=\"h-auto border-0 bg-transparent px-0\" />\n\t\t{#if hasBody}\n\t\t\t<IconPlaceholder\n\t\t\t\tlucide=\"ChevronDownIcon\"\n\t\t\t\ttabler=\"IconChevronDown\"\n\t\t\t\thugeicons=\"ArrowDown01Icon\"\n\t\t\t\tphosphor=\"CaretDownIcon\"\n\t\t\t\tremixicon=\"RiArrowDownSLine\"\n\t\t\t\tclass=\"ml-auto size-3.5 shrink-0 text-muted-foreground transition-transform group-data-[state=open]/tool:-scale-y-100\"\n\t\t\t/>\n\t\t{/if}\n\t</Collapsible.Trigger>\n\t{#if hasBody}\n\t\t<Collapsible.Content>\n\t\t\t<div class=\"flex min-w-0 flex-col gap-3 border-t px-3 py-3\">\n\t\t\t\t{#if input !== undefined}<ToolCallSection label=\"Input\" value={input} />{/if}\n\t\t\t\t{#if error}\n\t\t\t\t\t<p class=\"flex items-start gap-1.5 text-xs text-destructive\">\n\t\t\t\t\t\t<IconPlaceholder\n\t\t\t\t\t\t\tlucide=\"AlertCircleIcon\"\n\t\t\t\t\t\t\ttabler=\"IconAlertCircle\"\n\t\t\t\t\t\t\thugeicons=\"AlertCircleIcon\"\n\t\t\t\t\t\t\tphosphor=\"WarningCircleIcon\"\n\t\t\t\t\t\t\tremixicon=\"RiErrorWarningLine\"\n\t\t\t\t\t\t\tclass=\"mt-px size-4 shrink-0\"\n\t\t\t\t\t\t/>\n\t\t\t\t\t\t<span>{error}</span>\n\t\t\t\t\t</p>\n\t\t\t\t{:else if children}\n\t\t\t\t\t<div class=\"min-w-0\">{@render children()}</div>\n\t\t\t\t{:else if output !== undefined}\n\t\t\t\t\t<ToolCallSection label=\"Output\" value={output} />\n\t\t\t\t{/if}\n\t\t\t\t{#if actions}<div class=\"flex items-center gap-2\">{@render actions()}</div>{/if}\n\t\t\t</div>\n\t\t</Collapsible.Content>\n\t{/if}\n</Collapsible.Root>\n",
			"type": "registry:file",
			"target": "tool-call/tool-call.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { cn } from \"$UTILS$.js\";\n\timport type { Component } from \"svelte\";\n\timport ToolStatusIcon from \"./tool-status.svelte\";\n\timport type { ToolStatus } from \"./tool-call.svelte\";\n\n\t// A compact, inline pill for one tool call: icon, name, how long it took and its state.\n\tlet {\n\t\tname,\n\t\tstatus = \"done\",\n\t\ticon: Icon,\n\t\tduration,\n\t\tclass: className,\n\t}: {\n\t\tname: string;\n\t\tstatus?: ToolStatus;\n\t\ticon?: Component<{ class?: string }>;\n\t\t/** Milliseconds. Hidden while the call is running. */\n\t\tduration?: number;\n\t\tclass?: string;\n\t} = $props();\n\n\tconst time = $derived(\n\t\tstatus === \"running\" || duration === undefined\n\t\t\t? null\n\t\t\t: duration < 1000\n\t\t\t\t? `${Math.round(duration)}ms`\n\t\t\t\t: `${(duration / 1000).toFixed(1)}s`\n\t);\n</script>\n\n<span\n\tdata-slot=\"tool-chip\"\n\tdata-status={status}\n\taria-label=\"{name}, {status}\"\n\tclass={cn(\n\t\t\"inline-flex h-7 max-w-full min-w-0 items-center gap-1.5 rounded-full border bg-background px-2.5 text-xs font-medium text-foreground data-[status=error]:border-destructive/30 data-[status=error]:bg-destructive/5 data-[status=error]:text-destructive\",\n\t\tclassName\n\t)}\n>\n\t{#if Icon}\n\t\t<Icon class=\"size-4 shrink-0 text-muted-foreground\" />\n\t{:else}\n\t\t<IconPlaceholder\n\t\t\tlucide=\"WrenchIcon\"\n\t\t\ttabler=\"IconTool\"\n\t\t\thugeicons=\"Wrench01Icon\"\n\t\t\tphosphor=\"WrenchIcon\"\n\t\t\tremixicon=\"RiToolsLine\"\n\t\t\tclass=\"size-4 shrink-0 text-muted-foreground\"\n\t\t/>\n\t{/if}\n\t<span class=\"min-w-0 truncate\">{name}</span>\n\t{#if time}<span class=\"shrink-0 text-xs text-muted-foreground tabular-nums\">{time}</span>{/if}\n\t<ToolStatusIcon {status} />\n</span>\n",
			"type": "registry:file",
			"target": "tool-call/tool-chip.svelte"
		},
		{
			"content": "<script lang=\"ts\">\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport { Spinner } from \"$UI$/spinner/index.js\";\n\timport type { ToolStatus } from \"./tool-call.svelte\";\n\n\tlet { status }: { status: ToolStatus } = $props();\n</script>\n\n<span data-slot=\"tool-status\" class=\"flex size-4 shrink-0 items-center justify-center\">\n\t{#if status === \"running\"}\n\t\t<Spinner class=\"size-3.5\" />\n\t{:else if status === \"done\"}\n\t\t<IconPlaceholder\n\t\t\tlucide=\"CheckIcon\"\n\t\t\ttabler=\"IconCheck\"\n\t\t\thugeicons=\"Tick02Icon\"\n\t\t\tphosphor=\"CheckIcon\"\n\t\t\tremixicon=\"RiCheckLine\"\n\t\t\tclass=\"size-3.5 text-muted-foreground\"\n\t\t/>\n\t{:else}\n\t\t<IconPlaceholder\n\t\t\tlucide=\"AlertCircleIcon\"\n\t\t\ttabler=\"IconAlertCircle\"\n\t\t\thugeicons=\"AlertCircleIcon\"\n\t\t\tphosphor=\"WarningCircleIcon\"\n\t\t\tremixicon=\"RiErrorWarningLine\"\n\t\t\tclass=\"size-4 text-destructive\"\n\t\t/>\n\t{/if}\n</span>\n",
			"type": "registry:file",
			"target": "tool-call/tool-status.svelte"
		}
