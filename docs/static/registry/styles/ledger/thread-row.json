	"files": [
		{
			"content": "import ThreadRowSkeleton from \"./thread-row-skeleton.svelte\";\nimport ThreadRow, { type ThreadLabel, type ThreadPerson } from \"./thread-row.svelte\";\n\nexport { ThreadRow, ThreadRowSkeleton, type ThreadLabel, type ThreadPerson };\n",
			"type": "registry:file",
			"target": "thread-row/index.ts"
		},
		{
			"content": "<script lang=\"ts\">\n\timport { Skeleton } from \"$UI$/skeleton/index.js\";\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\t// The loading twin of ThreadRow: the same columns (unread dot, avatars, text), so the list does not jump when rows load.\n\t// It is hidden from screen readers; put aria-busy on the list that holds the rows.\n\tlet {\n\t\tref = $bindable(null),\n\t\tavatars = 2,\n\t\twithLabels = false,\n\t\tclass: className,\n\t\t...restProps\n\t}: WithElementRef<HTMLAttributes<HTMLDivElement>> & {\n\t\t/** How many avatar circles to draw. Default 2, the same as ThreadRow's default. */\n\t\tavatars?: number;\n\t\t/** Draw a label chip under the snippet. */\n\t\twithLabels?: boolean;\n\t} = $props();\n\n\tconst count = $derived(Number.isFinite(avatars) ? Math.max(1, Math.floor(avatars)) : 2);\n\tconst width = $derived(`${count * 1.5 - (count - 1) * 0.25}rem`);\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"thread-row-skeleton\"\n\taria-hidden=\"true\"\n\tclass={cn(\"flex items-start gap-3 border-b px-3 py-2.5\", className)}\n\t{...restProps}\n>\n\t<div class=\"w-3 shrink-0\"></div>\n\t<div class=\"flex shrink-0 -space-x-1\" style=\"width: {width}\">\n\t\t{#each { length: count } as _, i (i)}\n\t\t\t<Skeleton class=\"size-6 rounded-full ring-2 ring-background\" style=\"z-index: {count - i}\" />\n\t\t{/each}\n\t</div>\n\t<div class=\"min-w-0 flex-1\">\n\t\t<!-- Each line is as tall as a text-sm line (h-5) so the row is as tall as a loaded ThreadRow. -->\n\t\t<div class=\"flex h-5 items-center gap-2\">\n\t\t\t<Skeleton class=\"h-3.5 w-28 rounded\" />\n\t\t\t<Skeleton class=\"ms-auto h-3 w-10 rounded\" />\n\t\t</div>\n\t\t<div class=\"flex h-5 items-center\"><Skeleton class=\"h-3.5 w-3/4 rounded\" /></div>\n\t\t<div class=\"flex h-5 items-center\"><Skeleton class=\"h-3.5 w-full rounded\" /></div>\n\t\t{#if withLabels}\n\t\t\t<div class=\"mt-1 flex h-[18px] items-center\"><Skeleton class=\"h-3.5 w-14 rounded-full\" /></div>\n\t\t{/if}\n\t</div>\n</div>\n",
			"type": "registry:file",
			"target": "thread-row/thread-row-skeleton.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport type { BadgeTone } from \"$UI$/badge/badge.svelte\";\n\n\texport type ThreadPerson = { name: string; image?: string };\n\texport type ThreadLabel = { text: string; tone?: BadgeTone };\n</script>\n\n<script lang=\"ts\">\n\timport * as Avatar from \"$UI$/avatar/index.js\";\n\timport { Badge } from \"$UI$/badge/index.js\";\n\timport { Highlight } from \"$UI$/highlight/index.js\";\n\timport { StatusDot } from \"$UI$/status-dot/index.js\";\n\timport { cn, type WithElementRef } from \"$UTILS$.js\";\n\timport type { Snippet } from \"svelte\";\n\timport type { HTMLAttributes } from \"svelte/elements\";\n\n\t// One row of an inbox list: the people on the thread as an avatar group, the sender names, subject, a snippet of the\n\t// last message, the time, an unread dot and labels. `actions` shows on hover and keyboard focus, beside the row's link,\n\t// so it never nests a button inside the link. Composed from Avatar, Badge, Highlight and StatusDot.\n\tlet {\n\t\tref = $bindable(null),\n\t\tpeople,\n\t\tsubject,\n\t\tsnippet,\n\t\ttime,\n\t\tunread = false,\n\t\tselected = false,\n\t\tcount,\n\t\tlabels = [],\n\t\thighlight = [],\n\t\tmaxAvatars = 2,\n\t\thref,\n\t\tonclick,\n\t\tactions,\n\t\tclass: className,\n\t\t...restProps\n\t}: WithElementRef<Omit<HTMLAttributes<HTMLDivElement>, \"onclick\" | \"children\">> & {\n\t\t/** Who is on the thread, newest first. All names show in the row, joined and truncated; the avatars show the first `maxAvatars`. */\n\t\tpeople: ThreadPerson[];\n\t\tsubject: string;\n\t\tsnippet?: string;\n\t\t/** Text for the time, such as \"2:14 PM\" or \"Mon\". Format it yourself so the row has no timezone surprises. */\n\t\ttime?: string;\n\t\tunread?: boolean;\n\t\t/** The thread open in the pane. Sets `aria-current`. */\n\t\tselected?: boolean;\n\t\t/** Number of messages, shown beside the sender when above 1. */\n\t\tcount?: number;\n\t\tlabels?: ThreadLabel[];\n\t\t/** Search terms to mark in the names, subject and snippet. Case and accent insensitive. */\n\t\thighlight?: string[];\n\t\t/** Avatars shown before the \"+N\" count. Default 2. */\n\t\tmaxAvatars?: number;\n\t\t/** Makes the row a link. With only `onclick` it is a button. With neither, the row is not interactive. */\n\t\thref?: string;\n\t\tonclick?: (event: MouseEvent) => void;\n\t\t/** Buttons for hover, such as archive or snooze. Keep them as real buttons with labels. */\n\t\tactions?: Snippet;\n\t} = $props();\n\n\tconst max = $derived(Number.isFinite(maxAvatars) ? Math.max(1, Math.floor(maxAvatars)) : 2);\n\tconst shown = $derived(people.slice(0, max));\n\tconst extra = $derived(Math.max(0, people.length - shown.length));\n\tconst sender = $derived(people.map((p) => p.name).join(\", \"));\n\t// Width of the avatar column from what is shown: each avatar is 1.5rem and overlaps the next by 0.25rem, plus a slot for \"+N\".\n\tconst slots = $derived(shown.length + (extra > 0 ? 1 : 0));\n\tconst stackWidth = $derived(`${slots * 1.5 - Math.max(0, slots - 1) * 0.25}rem`);\n\tconst hasLink = $derived(Boolean(href || onclick));\n\tconst initials = (name: string) =>\n\t\tname\n\t\t\t.split(/\\s+/)\n\t\t\t.filter(Boolean)\n\t\t\t.slice(0, 2)\n\t\t\t.map((w) => w[0]?.toUpperCase())\n\t\t\t.join(\"\");\n</script>\n\n<div\n\tbind:this={ref}\n\tdata-slot=\"thread-row\"\n\tdata-unread={unread || undefined}\n\tdata-selected={selected || undefined}\n\tclass={cn(\n\t\t\"group/thread relative flex items-start gap-3 border-b px-3 py-2.5 text-sm transition-colors hover:bg-muted/50 has-[a:focus-visible,button:focus-visible]:bg-muted/50 data-[selected]:bg-muted\",\n\t\tclassName\n\t)}\n\t{...restProps}\n>\n\t{#if hasLink}\n\t\t<!-- svelte-ignore a11y_no_static_element_interactions -->\n\t\t<!-- The element is always a real link or button, which the checker cannot see through the dynamic tag. -->\n\t\t<svelte:element\n\t\t\tthis={href ? \"a\" : \"button\"}\n\t\t\t{href}\n\t\t\ttype={href ? undefined : \"button\"}\n\t\t\t{onclick}\n\t\t\taria-current={selected ? \"true\" : undefined}\n\t\t\tclass=\"absolute inset-0 z-0 outline-none focus-visible:ring-[3px] focus-visible:ring-ring/50 focus-visible:ring-inset\"\n\t\t>\n\t\t\t<span class=\"sr-only\">\n\t\t\t\t{unread ? \"Unread. \" : \"\"}{sender}. {subject}{count && count > 1\n\t\t\t\t\t? `. ${count} messages`\n\t\t\t\t\t: \"\"}{time ? `. ${time}` : \"\"}{labels.length\n\t\t\t\t\t? `. ${labels.map((l) => l.text).join(\", \")}`\n\t\t\t\t\t: \"\"}{snippet ? `. ${snippet}` : \"\"}\n\t\t\t</span>\n\t\t</svelte:element>\n\t{/if}\n\n\t<div class=\"pointer-events-none relative z-10 mt-0.5 flex w-3 shrink-0 justify-center pt-1.5\">\n\t\t{#if unread}<StatusDot tone=\"blue\" />{/if}\n\t</div>\n\n\t<Avatar.Group\n\t\tclass=\"pointer-events-none shrink-0 -space-x-1\"\n\t\tstyle=\"width: {stackWidth}\"\n\t\taria-hidden=\"true\"\n\t>\n\t\t{#each shown as person, i (i)}\n\t\t\t<Avatar.Root size=\"sm\" style=\"z-index: {shown.length - i}\">\n\t\t\t\t{#if person.image}<Avatar.Image src={person.image} alt=\"\" />{/if}\n\t\t\t\t<Avatar.Fallback>{initials(person.name)}</Avatar.Fallback>\n\t\t\t</Avatar.Root>\n\t\t{/each}\n\t\t{#if extra > 0}\n\t\t\t<Avatar.GroupCount class=\"size-6 rounded-full bg-muted text-xs\">+{extra}</Avatar.GroupCount>\n\t\t{/if}\n\t</Avatar.Group>\n\n\t<!-- With a link, its hidden label already says all of this, so hide the visible copy from screen readers. -->\n\t<div class=\"pointer-events-none min-w-0 flex-1\" aria-hidden={hasLink ? \"true\" : undefined}>\n\t\t<div\n\t\t\tclass={cn(\n\t\t\t\t\"flex items-baseline gap-2\",\n\t\t\t\tactions && \"group-focus-within/thread:pe-24 group-hover/thread:pe-24\"\n\t\t\t)}\n\t\t>\n\t\t\t<span class={cn(\"truncate\", unread ? \"font-semibold\" : \"font-medium\")}\n\t\t\t\t><Highlight text={sender} terms={highlight} /></span\n\t\t\t>\n\t\t\t{#if count && count > 1}<span class=\"text-xs text-muted-foreground\">{count}</span>{/if}\n\t\t\t{#if time}\n\t\t\t\t<span\n\t\t\t\t\tclass={cn(\n\t\t\t\t\t\t\"ms-auto shrink-0 text-xs text-muted-foreground tabular-nums\",\n\t\t\t\t\t\tactions && \"group-focus-within/thread:invisible group-hover/thread:invisible\"\n\t\t\t\t\t)}>{time}</span\n\t\t\t\t>\n\t\t\t{/if}\n\t\t</div>\n\t\t<div class={cn(\"truncate\", unread ? \"font-medium text-foreground\" : \"text-foreground/80\")}>\n\t\t\t<Highlight text={subject} terms={highlight} />\n\t\t</div>\n\t\t{#if snippet}<div class=\"truncate text-muted-foreground\">\n\t\t\t\t<Highlight text={snippet} terms={highlight} />\n\t\t\t</div>{/if}\n\t\t{#if labels.length}\n\t\t\t<div class=\"mt-1 flex flex-wrap gap-1\">\n\t\t\t\t{#each labels as label, i (i)}\n\t\t\t\t\t<Badge tone={label.tone ?? \"gray\"}>{label.text}</Badge>\n\t\t\t\t{/each}\n\t\t\t</div>\n\t\t{/if}\n\t</div>\n\n\t{#if actions}\n\t\t<div\n\t\t\tclass=\"pointer-events-none absolute end-2 top-2 z-10 flex items-center gap-0.5 opacity-0 transition-opacity group-focus-within/thread:pointer-events-auto group-focus-within/thread:opacity-100 group-hover/thread:pointer-events-auto group-hover/thread:opacity-100\"\n\t\t>\n\t\t\t{@render actions()}\n\t\t</div>\n\t{/if}\n</div>\n",
			"type": "registry:file",
			"target": "thread-row/thread-row.svelte"
		}
	]
}