{
	"$schema": "https://shadcn-svelte.com/schema/registry-item.json",
	"name": "ledger-tokens",
	"title": "Ledger tokens",
	"type": "registry:style",
	"description": "The Ledger design tokens (colors, radius, chip tones, field border and shadow) written into :root and .dark, plus the base layer that sets the default border and outline color. Re-add to update them. Color values come from the twenty-ui theme tokens (github.com/twentyhq/twenty, MIT License, Copyright (c) 2023-present Twenty.com, PBC).",
	"css": {
		".dark:not(\n    [data-slot=\"button\"]:is([data-variant=\"default\"], :not([data-variant])),\n    [class*=\"group/button\"][data-variant=\"default\"],\n    [data-slot=\"avatar-badge\"],\n    [data-slot=\"checkbox\"],\n    [data-slot=\"radio-group-item\"],\n    [data-slot=\"progress-indicator\"],\n    [data-slot=\"slider-range\"],\n    [data-slot=\"switch\"],\n    [data-slot=\"bubble\"][data-variant=\"default\"] > [data-slot=\"bubble-content\"],\n    [data-slot=\"questionnaire-choice-indicator\"],\n    [data-slot=\"button\"]:is([data-selected-single=\"true\"], [data-range-start=\"true\"], [data-range-end=\"true\"]),\n    [class~=\"bg-primary\"],\n    [class~=\"bg-primary!\"],\n    [class~=\"!bg-primary\"],\n    [class~=\"hover:bg-primary\"]:hover,\n    [class~=\"focus:bg-primary\"]:focus,\n    [class~=\"active:bg-primary\"]:active,\n    [class~=\"aria-selected:bg-primary\"][aria-selected=\"true\"],\n    [class~=\"aria-checked:bg-primary\"][aria-checked=\"true\"],\n    [class~=\"aria-current:bg-primary\"][aria-current]:not([aria-current=\"false\"]),\n    [class~=\"data-checked:bg-primary\"][data-checked],\n    [class~=\"data-selected:bg-primary\"][data-selected],\n    [class~=\"data-active:bg-primary\"][data-active],\n    [class~=\"data-[state=checked]:bg-primary\"][data-state=\"checked\"],\n    [class~=\"data-[state=on]:bg-primary\"][data-state=\"on\"],\n    [class~=\"data-[state=active]:bg-primary\"][data-state=\"active\"],\n    [class~=\"data-[active=true]:bg-primary\"][data-active=\"true\"],\n    [class~=\"data-[selected=true]:bg-primary\"][data-selected=\"true\"],\n    [class~=\"data-[selected]:bg-primary\"][data-selected],\n    [class~=\"data-[selected-single=true]:bg-primary\"][data-selected-single=\"true\"],\n    [class~=\"data-[range-start=true]:bg-primary\"][data-range-start=\"true\"],\n    [class~=\"data-[range-end=true]:bg-primary\"][data-range-end=\"true\"],\n    [class~=\"data-[range-start]:bg-primary\"][data-range-start],\n    [class~=\"data-[range-end]:bg-primary\"][data-range-end],\n    [class~=\"data-[state=completed]:bg-primary\"][data-state=\"completed\"],\n    [class~=\"data-[state=indeterminate]:bg-primary\"][data-state=\"indeterminate\"]\n  )": {
			"--ledger-primary-own": "var(--primary)",
			"--ledger-primary-foreground-own": "var(--primary-foreground)"
		},
		".dark :is(\n    [data-slot=\"button\"]:is([data-variant=\"default\"], :not([data-variant])),\n    [class*=\"group/button\"][data-variant=\"default\"],\n    [data-slot=\"avatar-badge\"],\n    [data-slot=\"checkbox\"],\n    [data-slot=\"radio-group-item\"],\n    [data-slot=\"progress-indicator\"],\n    [data-slot=\"slider-range\"],\n    [data-slot=\"switch\"],\n    [data-slot=\"bubble\"][data-variant=\"default\"] > [data-slot=\"bubble-content\"],\n    [data-slot=\"questionnaire-choice-indicator\"],\n    [data-slot=\"button\"]:is([data-selected-single=\"true\"], [data-range-start=\"true\"], [data-range-end=\"true\"]),\n    [class~=\"bg-primary\"],\n    [class~=\"bg-primary!\"],\n    [class~=\"!bg-primary\"],\n    [class~=\"hover:bg-primary\"]:hover,\n    [class~=\"focus:bg-primary\"]:focus,\n    [class~=\"active:bg-primary\"]:active,\n    [class~=\"aria-selected:bg-primary\"][aria-selected=\"true\"],\n    [class~=\"aria-checked:bg-primary\"][aria-checked=\"true\"],\n    [class~=\"aria-current:bg-primary\"][aria-current]:not([aria-current=\"false\"]),\n    [class~=\"data-checked:bg-primary\"][data-checked],\n    [class~=\"data-selected:bg-primary\"][data-selected],\n    [class~=\"data-active:bg-primary\"][data-active],\n    [class~=\"data-[state=checked]:bg-primary\"][data-state=\"checked\"],\n    [class~=\"data-[state=on]:bg-primary\"][data-state=\"on\"],\n    [class~=\"data-[state=active]:bg-primary\"][data-state=\"active\"],\n    [class~=\"data-[active=true]:bg-primary\"][data-active=\"true\"],\n    [class~=\"data-[selected=true]:bg-primary\"][data-selected=\"true\"],\n    [class~=\"data-[selected]:bg-primary\"][data-selected],\n    [class~=\"data-[selected-single=true]:bg-primary\"][data-selected-single=\"true\"],\n    [class~=\"data-[range-start=true]:bg-primary\"][data-range-start=\"true\"],\n    [class~=\"data-[range-end=true]:bg-primary\"][data-range-end=\"true\"],\n    [class~=\"data-[range-start]:bg-primary\"][data-range-start],\n    [class~=\"data-[range-end]:bg-primary\"][data-range-end],\n    [class~=\"data-[state=completed]:bg-primary\"][data-state=\"completed\"],\n    [class~=\"data-[state=indeterminate]:bg-primary\"][data-state=\"indeterminate\"]\n  )": {
			"--primary": "var(--primary-fill, var(--ledger-primary-own))",
			"--primary-foreground": "var(--primary-fill-foreground, var(--ledger-primary-foreground-own))"
		},
		".dark :is(\n  :is([data-slot=\"button\"], [class*=\"group/button\"])[data-variant=\"default\"],\n  [data-slot=\"button\"][class~=\"bg-primary\"],\n  [class~=\"group/button\"][class~=\"bg-primary\"]\n)": {
			"--foreground": "#000"
		},
		"@layer base": {
			"*": {
				"@apply border-border outline-ring/50": {}
			}
		}
	},
