		{
			"content": "<script lang=\"ts\">\n\timport { Progress } from \"$UI$/progress/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\t// Credits or usage left, as a meter that warns when it runs low.\n\tlet {\n\t\tused,\n\t\ttotal,\n\t\tlabel = \"credits left\",\n\t\twarnAt = 0.1,\n\t\tclass: className,\n\t}: {\n\t\tused: number;\n\t\ttotal: number;\n\t\tlabel?: string;\n\t\t/** Fraction remaining at which the meter turns to a warning. */\n\t\twarnAt?: number;\n\t\tclass?: string;\n\t} = $props();\n\n\tconst left = $derived(Math.max(0, total - used));\n\tconst ratio = $derived(total > 0 ? left / total : 0);\n\tconst low = $derived(total > 0 && ratio <= warnAt);\n</script>\n\n<div\n\tdata-slot=\"composer-usage\"\n\tdata-low={low ? \"\" : undefined}\n\tclass={cn(\n\t\t\"flex shrink-0 items-center gap-1.5 text-xs whitespace-nowrap text-muted-foreground\",\n\t\tclassName\n\t)}\n>\n\t<Progress\n\t\tvalue={ratio * 100}\n\t\taria-label=\"{left} {label}\"\n\t\tclass={cn(\"h-1 w-12\", low && \"[&>[data-slot=progress-indicator]]:bg-destructive\")}\n\t/>\n\t<span class={cn(\"tabular-nums\", low && \"text-destructive\")}>\n\t\t{left.toLocaleString()}<span class=\"hidden sm:inline\">{\" of \"}{total.toLocaleString()}</span>{\" \"}{label}\n\t</span>\n</div>\n",
			"type": "registry:file",
			"target": "composer/composer-usage.svelte"
		},
		{
			"content": "<script lang=\"ts\" module>\n\timport type { Component, Snippet } from \"svelte\";\n\n\texport type ComposerModel = {\n\t\tid: string;\n\t\tlabel: string;\n\t\tdescription?: string;\n\t\ticon?: Component<{ class?: string }>;\n\t\tbadge?: Snippet;\n\t};\n\n\ttype Recognition = {\n\t\tcontinuous: boolean;\n\t\tinterimResults: boolean;\n\t\tlang: string;\n\t\tstart: () => void;\n\t\tstop: () => void;\n\t\tonresult:\n\t\t\t| ((e: {\n\t\t\t\t\tresults: ArrayLike<ArrayLike<{ transcript: string }> & { isFinal: boolean }>;\n\t\t\t  }) => void)\n\t\t\t| null;\n\t\tonend: (() => void) | null;\n\t\tonerror: (() => void) | null;\n\t};\n\n\tfunction getRecognition(): (new () => Recognition) | null {\n\t\tif (typeof window === \"undefined\") return null;\n\t\tconst w = window as unknown as {\n\t\t\tSpeechRecognition?: new () => Recognition;\n\t\t\twebkitSpeechRecognition?: new () => Recognition;\n\t\t};\n\t\treturn w.SpeechRecognition ?? w.webkitSpeechRecognition ?? null;\n\t}\n</script>\n\n<script lang=\"ts\">\n\timport { onMount } from \"svelte\";\n\timport IconPlaceholder from \"$lib/components/icon-placeholder/icon-placeholder.svelte\";\n\timport * as DropdownMenu from \"$UI$/dropdown-menu/index.js\";\n\timport * as InputGroup from \"$UI$/input-group/index.js\";\n\timport * as Tooltip from \"$UI$/tooltip/index.js\";\n\timport { cn } from \"$UTILS$.js\";\n\n\t// The text box at the bottom of an AI chat. An Input Group with a growing textarea, a model picker leading the\n\t// bottom row, and voice dictation and send trailing it. Enter sends, Shift+Enter adds a line. While a reply streams\n\t// (`busy`), send turns into stop. Ported from the Another UI (React) Composer.\n\tlet {\n\t\tvalue = $bindable(\"\"),\n\t\tmodels,\n\t\tmodel = $bindable(),\n\t\tplaceholder = \"Ask anything\",\n\t\tdisabled = false,\n\t\tbusy = false,\n\t\tmaxRows = 8,\n\t\tonsubmit,\n\t\tonstop,\n\t\tclass: className,\n\t}: {\n\t\tvalue?: string;\n\t\tmodels?: ComposerModel[];\n\t\t/** The selected model id. Defaults to the first model. */\n\t\tmodel?: string;\n\t\tplaceholder?: string;\n\t\tdisabled?: boolean;\n\t\t/** While a reply streams, send turns into stop. */\n\t\tbusy?: boolean;\n\t\tmaxRows?: number;\n\t\tonsubmit?: (value: string, model?: string) => void;\n\t\tonstop?: () => void;\n\t\tclass?: string;\n\t} = $props();\n\n\tconst modelId = $derived(model ?? models?.[0]?.id);\n\tconst current = $derived(models?.find((m) => m.id === modelId));\n\tconst canSend = $derived(!disabled && value.trim().length > 0);\n\n\t// Voice dictation through the browser's speech recognition, when it has one.\n\tlet voice = $state<\"unsupported\" | \"idle\" | \"listening\">(\"idle\");\n\tlet recognition: Recognition | null = null;\n\tlet base = \"\";\n\tlet textarea = $state<HTMLTextAreaElement | null>(null);\n\n\tonMount(() => {\n\t\tif (!getRecognition()) voice = \"unsupported\";\n\t\treturn () => recognition?.stop();\n\t});\n\n\tfunction toggleVoice() {\n\t\tif (voice === \"listening\") {\n\t\t\trecognition?.stop();\n\t\t\treturn;\n\t\t}\n\t\tconst Ctor = getRecognition();\n\t\tif (!Ctor) return;\n\t\tconst r = new Ctor();\n\t\tr.continuous = true;\n\t\tr.interimResults = true;\n\t\tr.lang = navigator.language || \"en-US\";\n\t\tbase = value ? value.replace(/\\s*$/, \" \") : \"\";\n\t\tr.onresult = (e) => {\n\t\t\tlet text = \"\";\n\t\t\tfor (let i = 0; i < e.results.length; i++) text += e.results[i][0].transcript;\n\t\t\tvalue = base + text.trimStart();\n\t\t};\n\t\tr.onend = () => {\n\t\t\tvoice = \"idle\";\n\t\t\ttextarea?.focus();\n\t\t};\n\t\tr.onerror = () => (voice = \"idle\");\n\t\trecognition = r;\n\t\tr.start();\n\t\tvoice = \"listening\";\n\t}\n\n\tfunction submit() {\n\t\tif (busy) {\n\t\t\tonstop?.();\n\t\t\treturn;\n\t\t}\n\t\tif (!canSend) return;\n\t\trecognition?.stop();\n\t\tonsubmit?.(value.trim(), modelId);\n\t\tvalue = \"\";\n\t\ttextarea?.focus();\n\t}\n\n\tfunction onkeydown(e: KeyboardEvent) {\n\t\tif (e.key === \"Enter\" && !e.shiftKey && !e.isComposing) {\n\t\t\te.preventDefault();\n\t\t\tsubmit();\n\t\t}\n\t}\n</script>\n\n<InputGroup.Root\n\tdata-slot=\"composer\"\n\tdata-disabled={disabled ? \"true\" : undefined}\n\tclass={cn(\"bg-background\", className)}\n>\n\t<InputGroup.Textarea\n\t\tbind:ref={textarea}\n\t\tbind:value\n\t\t{disabled}\n\t\tplaceholder={voice === \"listening\" ? \"Listening...\" : placeholder}\n\t\taria-label=\"Message\"\n\t\trows={1}\n\t\t{onkeydown}\n\t\tstyle=\"max-height: calc({maxRows} * 1.5em + 1rem)\"\n\t\tclass=\"min-h-14 px-3 pt-3 text-base [field-sizing:content] md:text-sm\"\n\t/>\n\t<InputGroup.Addon align=\"block-end\" class=\"gap-1\">\n\t\t{#if models && models.length > 0}\n\t\t\t<DropdownMenu.Root>\n\t\t\t\t<DropdownMenu.Trigger>\n\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t<InputGroup.Button {...props} size=\"xs\" class=\"text-muted-foreground\" {disabled}>\n\t\t\t\t\t\t\t{#if current?.icon}\n\t\t\t\t\t\t\t\t<current.icon />\n\t\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t\t<IconPlaceholder lucide=\"SparklesIcon\" tabler=\"IconSparkles\" hugeicons=\"SparklesIcon\" phosphor=\"SparkleIcon\" remixicon=\"RiSparklingLine\" />\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t{current?.label ?? \"Model\"}\n\t\t\t\t\t\t\t<IconPlaceholder lucide=\"ChevronDownIcon\" tabler=\"IconChevronDown\" hugeicons=\"ArrowDown01Icon\" phosphor=\"CaretDownIcon\" remixicon=\"RiArrowDownSLine\" />\n\t\t\t\t\t\t</InputGroup.Button>\n\t\t\t\t\t{/snippet}\n\t\t\t\t</DropdownMenu.Trigger>\n\t\t\t\t<DropdownMenu.Content align=\"start\" side=\"top\" class=\"w-64\">\n\t\t\t\t\t<DropdownMenu.Label>Model</DropdownMenu.Label>\n\t\t\t\t\t<DropdownMenu.Separator />\n\t\t\t\t\t{#each models as m (m.id)}\n\t\t\t\t\t\t<DropdownMenu.Item\n\t\t\t\t\t\t\tonSelect={() => (model = m.id)}\n\t\t\t\t\t\t\tdata-active={m.id === modelId ? \"\" : undefined}\n\t\t\t\t\t\t\tclass=\"items-start data-active:bg-accent\"\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t{#if m.icon}\n\t\t\t\t\t\t\t\t<m.icon class=\"mt-0.5\" />\n\t\t\t\t\t\t\t{:else}\n\t\t\t\t\t\t\t\t<IconPlaceholder lucide=\"SparklesIcon\" tabler=\"IconSparkles\" hugeicons=\"SparklesIcon\" phosphor=\"SparkleIcon\" remixicon=\"RiSparklingLine\" class=\"mt-0.5\" />\n\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t<span class=\"flex min-w-0 flex-1 flex-col\">\n\t\t\t\t\t\t\t\t<span class=\"flex items-center gap-2 font-medium\">\n\t\t\t\t\t\t\t\t\t{m.label}\n\t\t\t\t\t\t\t\t\t{#if m.badge}{@render m.badge()}{/if}\n\t\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t\t\t{#if m.description}\n\t\t\t\t\t\t\t\t\t<span class=\"text-xs text-muted-foreground\">{m.description}</span>\n\t\t\t\t\t\t\t\t{/if}\n\t\t\t\t\t\t\t</span>\n\t\t\t\t\t\t</DropdownMenu.Item>\n\t\t\t\t\t{/each}\n\t\t\t\t</DropdownMenu.Content>\n\t\t\t</DropdownMenu.Root>\n\t\t{/if}\n\t\t<div class=\"ml-auto flex items-center gap-1\">\n\t\t\t<Tooltip.Root>\n\t\t\t\t<Tooltip.Trigger>\n\t\t\t\t\t{#snippet child({ props })}\n\t\t\t\t\t\t<InputGroup.Button\n\t\t\t\t\t\t\t{...props}\n\t\t\t\t\t\t\tsize=\"icon-sm\"\n\t\t\t\t\t\t\taria-label={voice === \"listening\" ? \"Stop dictation\" : \"Dictate\"}\n\t\t\t\t\t\t\taria-pressed={voice === \"listening\"}\n\t\t\t\t\t\t\t{disabled}\n\t\t\t\t\t\t\taria-disabled={voice === \"unsupported\" ? true : undefined}\n\t\t\t\t\t\t\tdata-listening={voice === \"listening\" ? \"\" : undefined}\n\t\t\t\t\t\t\tclass=\"rounded-full data-listening:bg-destructive/10 data-listening:text-destructive aria-disabled:opacity-50\"\n\t\t\t\t\t\t\tonclick={toggleVoice}\n\t\t\t\t\t\t>\n\t\t\t\t\t\t\t<IconPlaceholder lucide=\"MicIcon\" tabler=\"IconMicrophone\" hugeicons=\"Mic01Icon\" phosphor=\"MicrophoneIcon\" remixicon=\"RiMicLine\" class={cn(voice === \"listening\" && \"animate-pulse\")} />\n\t\t\t\t\t\t</InputGroup.Button>\n\t\t\t\t\t{/snippet}\n\t\t\t\t</Tooltip.Trigger>\n\t\t\t\t<Tooltip.Content>\n\t\t\t\t\t{voice === \"unsupported\"\n\t\t\t\t\t\t? \"Dictation is not available in this browser\"\n\t\t\t\t\t\t: voice === \"listening\"\n\t\t\t\t\t\t\t? \"Stop dictation\"\n\t\t\t\t\t\t\t: \"Dictate\"}\n\t\t\t\t</Tooltip.Content>\n\t\t\t</Tooltip.Root>\n\t\t\t<InputGroup.Button\n\t\t\t\tsize=\"icon-sm\"\n\t\t\t\tvariant=\"default\"\n\t\t\t\taria-label={busy ? \"Stop\" : \"Send message\"}\n\t\t\t\tdisabled={busy ? false : !canSend}\n\t\t\t\tclass=\"rounded-full\"\n\t\t\t\tonclick={submit}\n\t\t\t>\n\t\t\t\t{#if busy}<IconPlaceholder lucide=\"StopCircleIcon\" tabler=\"IconPlayerStop\" hugeicons=\"StopCircleIcon\" phosphor=\"StopCircleIcon\" remixicon=\"RiStopCircleLine\" />{:else}<IconPlaceholder lucide=\"ArrowUpIcon\" tabler=\"IconArrowUp\" hugeicons=\"ArrowUp01Icon\" phosphor=\"ArrowUpIcon\" remixicon=\"RiArrowUpLine\" />{/if}\n\t\t\t</InputGroup.Button>\n\t\t</div>\n\t</InputGroup.Addon>\n</InputGroup.Root>\n",
			"type": "registry:file",
			"target": "composer/composer.svelte"
		},
		{
			"content": "import Root, { type ComposerModel } from \"./composer.svelte\";\nimport Footer from \"./composer-footer.svelte\";\nimport Header from \"./composer-header.svelte\";\nimport Usage from \"./composer-usage.svelte\";\n\nexport {\n\tRoot,\n\tHeader,\n\tFooter,\n\tUsage,\n\t//\n\tRoot as Composer,\n\tHeader as ComposerHeader,\n\tFooter as ComposerFooter,\n\tUsage as ComposerUsage,\n\ttype ComposerModel,\n};\n",
			"type": "registry:file",
			"target": "composer/index.ts"
		}
	]
